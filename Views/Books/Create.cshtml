@model Book
@{
    ViewData["Title"] = "Add book";
}

<h1>Add a book</h1>
<form asp-action="Create" method="post" enctype="multipart/form-data" class="form">
    <div asp-validation-summary="ModelOnly" class="error"></div>
    <label asp-for="Title"></label>
    <input asp-for="Title" />
    <span asp-validation-for="Title" class="error"></span>

    <label asp-for="Author"></label>
    <input asp-for="Author" />
    <span asp-validation-for="Author" class="error"></span>

    <label asp-for="Genre"></label>
    <input asp-for="Genre" />
    <span asp-validation-for="Genre" class="error"></span>

    <label asp-for="Price"></label>
    <input asp-for="Price" type="number" step="0.01" />
    <span asp-validation-for="Price" class="error"></span>

    <label for="images">Images</label>
    <input id="images" name="images" type="file" accept="image/*" multiple />
    <button type="submit">Save book</button>
</form>
